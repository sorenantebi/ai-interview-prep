# Optional Google login. Leave unset to run without a login.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional: only these Google accounts may sign in (comma separated)
ALLOWED_EMAILS=

# Optional overrides
# CLAUDE_BIN=claude
# PYTHON_BIN=python3
# CONTENT_DIR=./content
