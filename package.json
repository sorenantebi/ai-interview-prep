{
  "name": "interview-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "fetch": "node scripts/fetch-neetcode.ts",
    "setup-python": "node scripts/setup-python.mjs",
    "app": "next build && next start -H 127.0.0.1",
    "electron": "node scripts/build-electron.mjs --no-pack && electron .",
    "dist": "node scripts/build-electron.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.8.6",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.2",
    "next": "15.5.4",
    "next-auth": "^4.24.11",
    "pdfjs-dist": "^6.4.299",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.prep.interview",
    "productName": "prep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "scripts/app-icon.png",
      "identity": "-",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "artifactName": "prep-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "scripts/app-icon.ico",
      "artifactName": "prep-windows-setup.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "scripts/app-icon.png",
      "category": "Education",
      "artifactName": "prep-linux.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
