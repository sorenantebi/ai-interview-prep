# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Your personal data: stays on this machine (remove lines to keep things in git)
content/progress.json
content/jobs.json
content/todos.json
content/plan.json
content/activity.json
content/mantra.txt
content/settings.json
content/interviews/*
!content/interviews/.gitkeep
content/notes/*
!content/notes/.gitkeep
# your uploads (Files → Upload)
content/misc/*
!content/misc/.gitkeep
# cloned repos are other people's projects (and would be nested git repos)
content/repos/*
!content/repos/.gitkeep
# except this one, tracked as a git submodule (see .gitmodules)
!content/repos/AI-Engineer-Interview-Questions
# your code, notes, drawings and tests per problem
content/**/attempt.py
content/**/solved.py
content/**/complexity.json
content/**/notes.md
content/**/drawing.json
content/**/notes.excalidraw
content/**/testcases.json
content/**/tests.py
content/**/my_tests.py
# the hidden tests ship with the app, so Submit works without Claude
!content/ml-coding/**/tests.py
!content/leetcode/**/tests.py
/.next-test/
/.venv/
/.next-electron/
/.electron/
/dist/
